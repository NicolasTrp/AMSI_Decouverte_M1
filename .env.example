# ─────────────────────────────────────────────────────────────────────────────
# lab-ctf-decouverte-m1 — « ShopXpress » (boutique de vente en ligne) — EXEMPLE
#
# Copier en `.env` puis adapter :   cp .env.example .env
# Le `.env` réel est gitignoré (vrais secrets/flags par équipe). Valeurs FACTICES.
#
# ⚠️ docker-compose v1 NE supprime PAS les commentaires en fin de ligne dans un
# .env : ne JAMAIS mettre de `# ...` après une valeur. Commentaires = lignes seules.
#
# Noms de variables (topologie, WEB_PUBLISH_*, FLAG_*) IDENTIQUES au lab de
# référence → le launcher CTFd provisionne ce lab sans modification.
# ─────────────────────────────────────────────────────────────────────────────

# --- Topologie réseau ---
DMZ_SUBNET=172.31.10.0/24
DMZ_GATEWAY=172.31.10.1
LAN_SUBNET=172.31.20.0/24
LAN_GATEWAY=172.31.20.1

# Adresses statiques (déterminisme routes / firewall)
FIREWALL_DMZ_IP=172.31.10.2
FIREWALL_LAN_IP=172.31.20.2
WEB_DMZ_IP=172.31.10.10
# DB_LAN_IP : non utilisé en découverte (gardé pour compat launcher)
DB_LAN_IP=172.31.20.10
FILES_LAN_IP=172.31.20.11
# WORKSTATION_LAN_IP = poste admin (cible finale)
WORKSTATION_LAN_IP=172.31.20.12

# Port applicatif INTERNE du point d'entrée web (dans le conteneur)
WEB_APP_PORT=8080
# Port HÔTE publié = LE POINT D'ENTRÉE donné aux étudiants
WEB_PUBLISH_PORT=8080
# IP d'écoute : 0.0.0.0 = joignable par les Kali ; 127.0.0.1 = test local
WEB_PUBLISH_IP=0.0.0.0
# Proxy d'egress contrôlé du LAN (patte LAN du firewall)
PROXY_PORT=8888

# --- Secrets de service (FACTICES) ---
SMB_USER=share
SMB_PASSWORD=changeme_smb
# Employé "stocks" : mot de passe CRACKABLE (MD5/rockyou), réutilisé SMB + SSH (files)
S_MOREL_PW=superman
# Autres employés (red herrings crackables, présents dans le backup de hash)
L_PETIT_PW=liverpool
N_ROUX_PW=chocolate
# Mot de passe maître du BACK-OFFICE révélé par le reverse (poste admin). DOIT
# rester égal à la valeur baked dans services/workstation/src/backoffice-check.c (XOR 0x5b).
ADMIN_MASTER_PW=ShopXpress-Adm-2024
# Secret/indice caché dans l'image (stéganographie)
STEGO_SECRET=stock-backup-2024

# --- Secrets gardés pour compat launcher (non utilisés en découverte) ---
DB_ROOT_PASSWORD=changeme_root
DB_APP_USER=reporting
DB_APP_PASSWORD=changeme_app
JWT_SECRET=shopxpress-secret-2026
MACHINE_ID=0f9d3c1ab2e74f60a1c2d3e4f5061728
AGENT_HMAC_KEY=dev-hmac-key-change-me
LDAP_BIND_PW=Sunb3am-Vault-2026
LDAP_MANAGER_PW=D1r3ct0ry-M4st3r-2026
J_MARTIN_PW=Adm1n-Sh0p!47-aZ
KEEPASS_MASTER_PW=sunshine

# --- Flags AMSI{...} (FACTICES — injectés par équipe via le plugin CTFd) ---
# web (DMZ) : 3 vulns web (auth bypass SQLi → upload RCE) + lecture fichiers + privesc
FLAG_WEB_RCE=AMSI{web_upload_php_rce_dev}
FLAG_WEB_REVERSE=AMSI{web_lfi_path_traversal_dev}
FLAG_WEB_ROOT=AMSI{web_sudo_tar_root_dev}
# fileshare (LAN) : Pivot / Forensique / Stégano / Crypto / Privesc
FLAG_FILES_RECON=AMSI{smb_anon_recon_dev}
FLAG_DB_PIVOT=AMSI{pcap_clear_login_dev}
FLAG_DB_ROOT=AMSI{stego_image_hidden_dev}
FLAG_FILES_RCE=AMSI{md5_crack_rockyou_dev}
FLAG_FILES_ROOT=AMSI{cron_writable_root_dev}
# admin (LAN) : Pwn / Reverse / final
FLAG_WS_ROOT=AMSI{bof_ret2win_root_dev}
FLAG_FINAL=AMSI{reverse_backoffice_takeover_dev}
